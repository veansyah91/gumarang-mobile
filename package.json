{
  "name": "gumarang-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:gold-detail": "node create-gold-detail.js",
    "start": "expo start",
    "android": "expo run:android",
    "preandroid": "npm run sync:google-services",
    "prebuild": "node ./scripts/cleanup-dead-routes.js && node ./scripts/validate-google-services.js",
    "validate:google-services": "node ./scripts/validate-google-services.js",
    "sync:google-services": "node ./scripts/sync-google-services.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "build:android:apk": "eas build -p android --profile production-apk",
    "build:android:aab": "eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/fingerprint": "^0.16.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.0",
    "expo": "^55.0.24",
    "expo-constants": "~55.0.16",
    "expo-contacts": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.7",
    "expo-linking": "~55.0.15",
    "expo-notifications": "~55.0.23",
    "expo-print": "~55.0.17",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.22",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
